{
  "name": "getbothtn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "clean": "node scripts/clean.mjs",
    "predev": "node scripts/clean.mjs && prisma generate",
    "dev": "next dev",
    "prebuild": "node scripts/clean.mjs && prisma generate",
    "build": "next build",
    "prestart": "prisma generate",
    "start": "next start",
    "db:setup": "prisma generate && prisma db push --skip-generate --force-reset && tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "chat:cleanup": "tsx scripts/purge-chats.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "bcryptjs": "2.4.3",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "allowScripts": {
    "@prisma/client@6.7.0": true,
    "@prisma/engines@6.7.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "prisma@6.7.0": true
  }
}
